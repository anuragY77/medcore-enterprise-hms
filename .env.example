# Auth.js / NextAuth Configuration
# IMPORTANT: In production, generate a real secret with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-secure-secret"
AUTH_URL="http://localhost:3000"

# Server-side idle timeout in minutes (1-480; default 15 when unset/invalid).
# Exports the session after this much inactivity; real user input re-records
# activity, background session polls never do. Complements (never extends)
# the 12-hour absolute session lifetime.
SESSION_IDLE_TIMEOUT_MINUTES="15"

# PostgreSQL Database
DATABASE_URL="postgresql://USERNAME:PASSWORD@localhost:5432/DATABASE_NAME"

# Environment
NODE_ENV="development"
